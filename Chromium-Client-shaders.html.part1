<!DOCTYPE html>
<html style="width:100%;height:100%;background-color:black;">
<head>
<!-- chromium-boot-v1 -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#8a3dff">
<title>Chromium Client</title>
<style id="chromium-boot-css">
@font-face{font-family:"CBDisplay";font-style:normal;font-weight:200 900;font-display:block;src:url(data:font/woff;base64,) format("woff");}
@font-face{font-family:"CBBody";font-style:normal;font-weight:300 900;font-display:block;src:url(data:font/woff;base64,) format("woff");}
html,body{margin:0;background:#8a3dff;}
#loading_screen{display:none !important;}
#cb{--a:#ff2d8f;--b:#ff9a1a;--x:50%;--y:58%;position:fixed;inset:0;z-index:2147483647;overflow:hidden;display:grid;place-items:center;color:#fff;
 font-family:"CBBody",system-ui,-apple-system,"Segoe UI",sans-serif;user-select:none;-webkit-user-select:none;cursor:default;
 transition:opacity .7s cubic-bezier(.2,.8,.2,1),transform .7s cubic-bezier(.2,.8,.2,1);}
#cb .cb-bg{position:absolute;inset:0;background:radial-gradient(circle at var(--x) var(--y),var(--a),var(--b) 55%,#8a3dff 110%);}
#cb .cb-glow{position:absolute;width:90vmax;height:90vmax;border-radius:50%;left:50%;top:50%;margin:-45vmax 0 0 -45vmax;
 background:radial-gradient(circle,rgba(255,255,255,.28) 0%,rgba(255,255,255,0) 60%);}
#cb .cb-orb{position:absolute;border-radius:50%;opacity:.55;}
#cb .cb-orb.o1{width:60vmax;height:60vmax;left:-18vmax;top:-22vmax;background:radial-gradient(circle,var(--a) 0%,transparent 68%);}
#cb .cb-orb.o2{width:56vmax;height:56vmax;right:-20vmax;bottom:-24vmax;background:radial-gradient(circle,#8a3dff 0%,transparent 66%);}
#cb .cb-orb.o3{width:40vmax;height:40vmax;right:-8vmax;top:-12vmax;background:radial-gradient(circle,var(--b) 0%,transparent 66%);}
#cb .cb-grid{position:absolute;inset:0;opacity:.35;background-image:linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.12) 1px,transparent 1px);
 background-size:44px 44px;-webkit-mask-image:radial-gradient(ellipse at 50% 45%,#000 0%,transparent 70%);mask-image:radial-gradient(ellipse at 50% 45%,#000 0%,transparent 70%);}
#cb .cb-in{position:relative;display:flex;flex-direction:column;align-items:center;gap:14px;width:min(480px,86vw);text-align:center;}
#cb .cb-logo{width:clamp(84px,14vmin,128px);height:clamp(84px,14vmin,128px);filter:drop-shadow(0 14px 34px rgba(40,0,80,.32));animation:cbLogoIn 1s cubic-bezier(.34,1.4,.5,1) both,cbFloat 3.6s ease-in-out 1s infinite alternate;}
#cb .cb-name{font-family:"CBDisplay","CBBody",system-ui,sans-serif;font-weight:700;font-size:clamp(24px,4.4vmin,40px);letter-spacing:-.01em;line-height:1.15;
 text-shadow:0 4px 22px rgba(40,0,80,.25);animation:cbRise .7s .15s cubic-bezier(.2,.8,.2,1) both;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#cb .cb-sub{font-weight:700;font-size:16px;opacity:.92;margin-top:-6px;animation:cbRise .7s .25s cubic-bezier(.2,.8,.2,1) both;}
#cb .cb-card{margin-top:10px;width:100%;box-sizing:border-box;padding:14px 16px 12px;border-radius:18px;background:rgba(255,255,255,.2);
 border:1px solid rgba(255,255,255,.34);box-shadow:0 1px 0 rgba(255,255,255,.4) inset,0 18px 40px rgba(40,0,80,.18);
animation:cbRise .7s .35s cubic-bezier(.2,.8,.2,1) both;}
#cb .cb-row{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:15px;font-weight:600;margin-bottom:10px;}
#cb .cb-status{opacity:.95;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;transition:opacity .25s;}
#cb .cb-pct{font-family:"CBDisplay","CBBody",sans-serif;font-weight:700;font-size:14px;font-variant-numeric:tabular-nums;opacity:.95;}
#cb .cb-bar{position:relative;height:12px;border-radius:99px;background:rgba(255,255,255,.22);overflow:hidden;box-shadow:0 1px 2px rgba(40,0,80,.15) inset;}
#cb .cb-fill{position:absolute;inset:0;border-radius:99px;transform-origin:0 50%;transform:scaleX(.02);transition:transform .35s cubic-bezier(.2,.8,.2,1);
 background:linear-gradient(90deg,#fff,#ffe9f5 60%,#fff);box-shadow:0 0 14px rgba(255,255,255,.75);will-change:transform;}
#cb .cb-shine{position:absolute;top:0;bottom:0;width:90px;left:-90px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.65),transparent);animation:cbShine 1.8s ease-in-out infinite;}
#cb .cb-tip{position:absolute;left:16px;right:16px;bottom:max(22px,5vh);text-align:center;font-size:15px;font-weight:600;opacity:.88;transition:opacity .4s;}
#cb .cb-tip b{font-weight:800;}
#cb.cb-done .cb-logo{animation:cbPop .5s cubic-bezier(.34,1.4,.5,1) both;}
#cb.cb-out{opacity:0;transform:scale(1.04);pointer-events:none;}
@keyframes cbLogoIn{from{opacity:0;transform:scale(.4) rotate(-30deg);}to{opacity:1;transform:none;}}
@keyframes cbFloat{from{transform:translateY(-4px);}to{transform:translateY(5px);}}
@keyframes cbPop{0%{transform:scale(1);}45%{transform:scale(1.12);}100%{transform:scale(1);}}
@keyframes cbRise{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:none;}}
@keyframes cbShine{0%{left:-90px;}70%,100%{left:calc(100% + 90px);}}
@keyframes cbBreath{from{transform:scale(.92);opacity:.7;}to{transform:scale(1.08);opacity:1;}}
@keyframes cbDriftA{from{transform:translate(0,0) scale(1);}to{transform:translate(10vw,8vh) scale(1.15);}}
@keyframes cbDriftB{from{transform:translate(0,0) scale(1.08);}to{transform:translate(-9vw,-7vh) scale(.92);}}
@keyframes cbDriftC{from{transform:translate(0,0) scale(.95);}to{transform:translate(-6vw,10vh) scale(1.12);}}
@media (prefers-reduced-motion: reduce){#cb *{animation:none !important;}#cb,#cb .cb-fill{transition:none;}}
</style>
<div id="cb" role="progressbar" aria-label="Loading Chromium Client" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
 <div class="cb-bg"></div><div class="cb-orb o1"></div><div class="cb-orb o3"></div><div class="cb-orb o2"></div><div class="cb-grid"></div><div class="cb-glow"></div>
 <div class="cb-in">
  <img class="cb-logo" alt="" src="data:image/svg+xml;base64,">
  <div class="cb-name" id="cbName">Chromium Client</div>
  <div class="cb-sub" id="cbSub">Starting&hellip;</div>
  <div class="cb-card">
   <div class="cb-row"><span class="cb-status" id="cbStatus">Unpacking the game&hellip;</span><span class="cb-pct" id="cbPct">0%</span></div>
   <div class="cb-bar"><div class="cb-fill" id="cbFill"></div><div class="cb-shine"></div></div>
  </div>
 </div>
 <div class="cb-tip" id="cbTip"></div>
</div>
<script>
/* Chromium Client boot screen: shows instantly (before the 90 MB of game data is read), follows every
   loading step to the title screen, and matches the colours of the launcher instance that opened it. */
(function () {
 "use strict";
 var cb = document.getElementById("cb"); if (!cb) return;
 var $ = function (id) { return document.getElementById(id); };
 var fill = $("cbFill"), pctEl = $("cbPct"), statusEl = $("cbStatus"), tipEl = $("cbTip");
 var hash = {}; try { location.hash.replace(/^#/, "").split("&").forEach(function (kv) { var i = kv.indexOf("="); if (i > 0) hash[kv.slice(0, i)] = decodeURIComponent(kv.slice(i + 1)); }); } catch (e) {}
 var okCol = function (c) { return typeof c === "string" && /^#[0-9a-fA-F]{6}$/.test(c) ? c : null; };
 var ca = okCol(hash.c1) || "#ff2d8f", cbc = okCol(hash.c2) || "#ff9a1a";
 cb.style.setProperty("--a", ca); cb.style.setProperty("--b", cbc);
 var px = parseFloat(hash.cx), py = parseFloat(hash.cy);
 if (px >= 0 && px <= 100 && py >= 0 && py <= 100) { cb.style.setProperty("--x", px + "%"); cb.style.setProperty("--y", py + "%"); }
 if (hash.iname) $("cbName").textContent = hash.iname.slice(0, 40);
 if (hash.joinName || hash.join) $("cbSub").textContent = "Joining " + (hash.joinName || hash.join).slice(0, 40) + "\u2026";
 window.__chromiumBoot = { colors: [ca, cbc], center: [isNaN(px) ? 50 : px, isNaN(py) ? 58 : py] };

 /* ---- progress: a target the bar eases toward ---- */
 var target = 0.02, shown = 0.02, finished = false, removed = false;
 function setTarget(p, text) { if (finished) return; if (p > target) target = Math.min(p, 0.995); if (text) status(text); }
 function status(text) { if (statusEl.textContent !== text) statusEl.textContent = text; }
 function paint() {
  shown += (target - shown) * 0.18; if (Math.abs(target - shown) < 0.001) shown = target;
  fill.style.transform = "scaleX(" + Math.max(0.02, shown).toFixed(4) + ")";
  var n = Math.floor(shown * 100); pctEl.textContent = n + "%"; cb.setAttribute("aria-valuenow", n);
 }
 var ticker = setInterval(paint, 50);

 /* ---- step 1: reading the page (the game data is inline, so we watch each block arrive) ---- */
 var blocks = { "eag-inline-decoder": 0.01, "eag-inline-wasm-br": 0.03, "eag-inline-mesh-wasm-br": 0.12, "eag-inline-server-wasm-br": 0.14, "eag-inline-assets": 0.19, "eag-inline-sounds": 0.26 };
 /* creep slowly toward the end of the current step so the bar never looks stuck */
 var cap = 0.3;
 var creep = setInterval(function () { if (target < cap) setTarget(target + (cap - target) * 0.006); }, 120);
 try {
  var mo = new MutationObserver(function (list) {
   for (var i = 0; i < list.length; i++) for (var j = 0; j < list[i].addedNodes.length; j++) {
    var n = list[i].addedNodes[j]; if (!n || n.nodeType !== 1) continue;
    if (n.id && blocks[n.id] !== undefined) setTarget(blocks[n.id], n.id === "eag-inline-sounds" || n.id === "eag-inline-assets" ? "Unpacking textures and sounds\u2026" : "Unpacking the game\u2026");
    else if (n.tagName === "SCRIPT" && !n.id && target >= 0.26) setTarget(0.31, "Unpacking textures and sounds\u2026");
    if (n.classList && n.classList.contains("_eaglercraftX_crash_element")) crashed();
   }
  });
  mo.observe(document.documentElement, { childList: true, subtree: true });
 } catch (e) {}

 /* ---- step 2: compiling WebAssembly (the shell logs into window.__log) ---- */
 function onLog(m) {
  m = String(m);
  if (m.indexOf("compileStreaming path OK") >= 0) setTarget(0.44, "Starting the engine\u2026");
  else if (m.indexOf("Wasm compiled") >= 0 || m.indexOf("Wasm + shared") >= 0) setTarget(0.48, "Starting the engine\u2026");
  else if (m.indexOf("wasm compiled + instantiated") >= 0) setTarget(0.5, "Starting Minecraft 26.2\u2026");
  else if (m.indexOf("SHELL_ERR") >= 0 || m.indexOf("E:[shell]") === 0) crashed();
 }
 var logArr;
 try {
  Object.defineProperty(window, "__log", { configurable: true, get: function () { return logArr; }, set: function (v) {
   logArr = v; if (v && v.push && !v.__cbHooked) { var p = v.push; v.push = function () { for (var i = 0; i < arguments.length; i++) try { onLog(arguments[i]); } catch (e) {} return p.apply(this, arguments); }; v.__cbHooked = true; } } });
 } catch (e) {}
 document.addEventListener("DOMContentLoaded", function () { cap = 0.46; setTarget(0.36, "Starting the engine\u2026"); });

 /* ---- step 3: the Java side reports its own boot steps ---- */
 var bootFn;
 try {
  Object.defineProperty(window, "__eaglerBoot", { configurable: true, get: function () { return bootWrap; }, set: function (f) { bootFn = f; } });
 } catch (e) {}
 function bootWrap(pct, text) {
  try { if (bootFn) bootFn(pct, text); } catch (e) {}
  if (typeof pct === "number") {
   var t = String(text || "");
   if (/^Downloading assets|^Decompressing/i.test(t)) t = "Loading textures and sounds\u2026";
   else if (/^Initializing filesystem|filesystem/i.test(t)) t = "Opening your worlds\u2026";
   else if (!t || /Chromium Client|^Starting Minecraft/i.test(t)) t = "Starting Minecraft 26.2\u2026";
   setTarget(0.5 + Math.max(0, Math.min(100, pct)) / 100 * 0.1, t); cap = 0.63;
  }
 }

 /* ---- step 4: Minecraft loads its resources; LoadingOverlay calls this every frame ---- */
 var lastBridge = 0, readyAt = 0;
 window.__chromiumLoad = function (p, done) {
  lastBridge = Date.now();
  p = Math.max(0, Math.min(1, +p || 0));
  cap = 0; if (done) finish(); else setTarget(0.64 + p * 0.35, "Loading resources\u2026");
 };
 var watch = setInterval(function () {
  if (removed) { clearInterval(watch); return; }
  if (document.querySelector("._eaglercraftX_crash_element") || window.__err) { crashed(); return; }
  if (window.__eaglerGameReady === true && !readyAt) { readyAt = Date.now(); cap = 0.7; setTarget(0.64, "Loading resources\u2026"); }
  /* older builds without the bridge: reveal the game shortly after it is ready */
  if (readyAt && !lastBridge && Date.now() - readyAt > 6000) finish();
  if (readyAt && Date.now() - readyAt > 240000) finish();
 }, 200);

 function finish() {
  if (finished) return; finished = true; target = 1; shown = Math.max(shown, 0.97); paint(); status("Ready!");
  cb.classList.add("cb-done");
  setTimeout(function () { shown = 1; paint(); cb.classList.add("cb-out"); }, 420);
  setTimeout(remove, 1200);
 }
 function crashed() { if (!removed) remove(); }
 function remove() {
  if (removed) return; removed = true; clearInterval(ticker); clearInterval(creep); clearInterval(tipTimer);
  try { mo.disconnect(); } catch (e) {}
  if (cb.parentNode) cb.parentNode.removeChild(cb);
 }

 /* ---- tips ---- */
 var tips = ["Press <b>Right Shift</b> in game to open Chromium Visuals", "Hold <b>Z</b> to zoom smoothly", "Turn on <b>Performance Mode</b> on weak laptops and Chromebooks",
  "Pick a closer server region under <b>Multiplayer &gt; Regions</b>", "Six resource packs are built in: <b>Options &gt; Resource Packs</b>", "Press <b>Y</b> with a sword out to inspect your knife"];
 var tipN = Math.floor(Math.random() * tips.length);
 function nextTip() { tipEl.style.opacity = 0; setTimeout(function () { tipEl.innerHTML = "Tip: " + tips[tipN++ % tips.length]; tipEl.style.opacity = .88; }, 400); }
 tipEl.innerHTML = "Tip: " + tips[tipN++ % tips.length];
 var tipTimer = setInterval(nextTip, 5000);
})();
</script>
<!-- chromium-boot-end -->

